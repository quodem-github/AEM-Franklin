<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="GenesysImportProcess.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="GenesysImportProcess.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="GenesysImportProcess.Properties.Settings.SqlConnectionString"
      connectionString="Server=PRE-DBServer01.quodem.net;Database=WINTOUR_ROBOT_EOS-STAGING;User Id=quodem_web;Password=Quowppo10;"
      providerName="Sql.Data.SqlClient" />
  </connectionStrings>
  <userSettings>
    <GenesysImportProcess.Properties.Settings>
      <setting name="SftpUserName" serializeAs="String">
        <value>ftp_msd_cornerstone_test</value>
      </setting>
      <setting name="SftpPassword" serializeAs="String">
        <value>1KE3Mubc</value>
      </setting>
      <setting name="SftpPort" serializeAs="String">
        <value>22</value>
      </setting>
      <setting name="SftpInitialDirectory" serializeAs="String">
        <value>/MSD_IN/</value>
      </setting>
      <setting name="ItemsPerInsert" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="CsvSeparator" serializeAs="String">
        <value>\t</value>
      </setting>
      <setting name="TestMode" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="StoreProcedureNameLoadMasterTable" serializeAs="String">
        <value>sp_genesys_load_master_table_v2</value>
      </setting>
      <setting name="ProcessDescription" serializeAs="String">
        <value>MSD Importación de datos de Genesys</value>
      </setting>
      <setting name="LocalDirectoryToDownloadPath" serializeAs="String">
        <value>C:\Users\jmartin\Desktop\Eos.Genesys\</value>
      </setting>
      <setting name="TxtSeparator" serializeAs="String">
        <value>,</value>
      </setting>
      <setting name="TempTableName" serializeAs="String">
        <value>hcp_genesys_tmp</value>
      </setting>
      <setting name="FileLogDirectory" serializeAs="String">
        <value>C:\Users\jmartin\Desktop\Eos.Genesys\</value>
      </setting>
      <setting name="StoreProcedureUpdatePassengerList" serializeAs="String">
        <value>sp_genesys_update_passengerList_v2</value>
      </setting>
      <setting name="DateFormatGenesysFileMasterPattern" serializeAs="String">
        <value>yyyyMMdd</value>
      </setting>
      <setting name="GenesysFileMasterPattern" serializeAs="String">
        <value>agency_prescriber_master_</value>
      </setting>
    </GenesysImportProcess.Properties.Settings>
  </userSettings>
  <applicationSettings>
    <GenesysImportProcess.Properties.Settings>
      <setting name="SftpHost" serializeAs="String">
        <value>ftpserver.quodem.com</value>
      </setting>
    </GenesysImportProcess.Properties.Settings>
  </applicationSettings>
  <appSettings>
    <!-- Configuracion del proceso -->
    <add key="Monitor.LogName" value="procesos\MSD-GenesysImport\log"/>
    <add key="Quodem.Monitor.Procesos.Nombre" value="MSD-GenesysImport"/>
    <add key="Quodem.Monitor.Procesos.Para" value="jmartin@quodem.com"/>
    <add key="Quodem.Monitor.Procesos.TipoLog" value="Ejecucion"/>
    <add key="Quodem.Monitor.Procesos.EnvioLog" value="Error"/>
    <add key="Quodem.Monitor.Procesos.EnvioMail" value="Siempre"/>
    <add key="Quodem.Monitor.Procesos.NivelMensajes" value="5"/>
  </appSettings>
</configuration>