<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="Iatas" table="iatas">
    <id name="Id" type="Int32">
      <column name="id" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Idiata" type="String">
      <column name="IdIata" default="N''" not-null="true" length="5" sql-type="nvarchar" />
    </property>
    <property name="Idconfempresa" type="Int32">
      <column name="idconfempresa" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Idpoblacion" type="Int32">
      <column name="IdPoblacion" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Iata" type="String">
      <column name="Iata" default="N''" not-null="false" length="35" sql-type="nvarchar" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
  </class>
</hibernate-mapping>