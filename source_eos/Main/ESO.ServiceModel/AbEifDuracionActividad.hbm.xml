<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="AbEifDuracionActividad" table="ab_eif_duracion_actividad">
    <id name="Id" type="Int32">
      <column name="id" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Text" type="String">
      <column name="Text" default="''" not-null="true" length="50" sql-type="varchar" />
    </property>
    <property name="Value" type="Double">
      <column name="Value" default="0.00" not-null="true" precision="53" sql-type="float" />
    </property>
    <set name="CalcCorrespondencias" inverse="true" generic="true">
      <key>
        <column name="idDuracionActividadAbEif" />
      </key>
      <one-to-many class="CalcCorrespondencias" />
    </set>
  </class>
</hibernate-mapping>