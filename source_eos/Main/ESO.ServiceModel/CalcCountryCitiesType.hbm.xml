<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="CalcCountryCitiesType" table="calc_country_cities_type">
    <id name="Id" type="Int32">
      <column name="id" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Text" type="String">
      <column name="Text" default="N''" not-null="true" length="150" sql-type="nvarchar" />
    </property>
    <set name="CalcCountryCorrespondencias" inverse="true" generic="true">
      <key>
        <column name="idCitiesType" />
      </key>
      <one-to-many class="CalcCountryCorrespondencias" />
    </set>
  </class>
</hibernate-mapping>