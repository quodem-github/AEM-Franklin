<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="Provincias" table="provincias">
    <id name="Idprovincia" type="String">
      <column name="IdProvincia" default="N''" not-null="true" length="3" sql-type="nvarchar" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Provincia" type="String">
      <column name="Provincia" default="N''" not-null="true" length="20" sql-type="nvarchar" />
    </property>
    <property name="Idpais" type="String">
      <column name="IdPais" default="N''" not-null="true" length="3" sql-type="nvarchar" />
    </property>
    <property name="Idcomunidad" type="Int32">
      <column name="IdComunidad" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <many-to-one name="Comunidad" class="Comunidad" update="false" insert="false">
      <column name="IdComunidad" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </many-to-one>
  </class>
</hibernate-mapping>