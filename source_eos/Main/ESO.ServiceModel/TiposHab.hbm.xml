<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="TiposHab" table="tipos_hab">
    <id name="Idtipohab" type="String">
      <column name="IdTipoHab" default="N''" not-null="true" length="3" sql-type="nvarchar" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Tipohab" type="String">
      <column name="TipoHab" default="N''" not-null="true" length="25" sql-type="nvarchar" />
    </property>
    <property name="Ocup" type="Int32">
      <column name="Ocup" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <set name="Serviciosreservashotels" inverse="true" generic="true">
      <key>
        <column name="idtipohab" />
      </key>
      <one-to-many class="Serviciosreservashotel" />
    </set>
    <set name="Tarifasalojs" inverse="true" generic="true">
      <key>
        <column name="IdTipoHab" />
      </key>
      <one-to-many class="Tarifasaloj" />
    </set>
  </class>
</hibernate-mapping>