<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="JustificacionesDatosadicionales" table="justificaciones_datosadicionales">
    <id name="Idjustificaciones" type="Int64">
      <column name="idjustificaciones" not-null="true" precision="19" scale="0" sql-type="bigint" />
      <generator class="identity" />
    </id>
    <property name="Justificaciones" type="String">
      <column name="justificaciones" not-null="true" length="250" sql-type="varchar" />
    </property>
    <property name="Inactivo" type="Int16">
      <column name="inactivo" default="0" not-null="true" precision="5" scale="0" sql-type="smallint" />
    </property>
    <set name="DatosadicionalesReservasPassengers" inverse="true" generic="true">
      <key>
        <column name="idjustificaciones" />
      </key>
      <one-to-many class="DatosadicionalesReservasPassenger" />
    </set>
  </class>
</hibernate-mapping>