    <property name="Nombre" type="String">
      <column name="nombre" default="N''" not-null="true" length="80" sql-type="nvarchar" />
    </property>
    <property name="Desde" type="DateTime">
      <column name="desde" not-null="true" sql-type="datetime2" />
    </property>
    <property name="Hasta" type="DateTime">
      <column name="hasta" not-null="true" sql-type="datetime2" />
    </property>
    <property name="Idpoblacion" type="Int32">
