    </property>
    <property name="Internacional" type="Int16">
      <column name="internacional" default="0" not-null="false" precision="5" scale="0" sql-type="smallint" />
    </property>
    <property name="UrlWeb" type="String">
      <column name="url_web" default="N''" not-null="false" length="128" sql-type="nvarchar" />
