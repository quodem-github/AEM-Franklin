<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="ProductosPrv" table="productos_prv">
    <id name="Idproductoprv" type="Int32">
      <column name="IdProductoPrv" default="0" not-null="true" precision="10" scale="0" sql-type="int" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Fkidproveedor" type="Int32">
      <column name="FKIdProveedor" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Desproducto" type="String">
      <column name="DesProducto" default="N''" not-null="true" length="100" sql-type="nvarchar" />
    </property>
    <property name="Inactivo" type="Int16">
      <column name="Inactivo" default="0" not-null="true" precision="5" scale="0" sql-type="smallint" />
    </property>
    <property name="Idproducto" type="String">
      <column name="idproducto" default="N''" not-null="true" length="3" sql-type="nvarchar" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <many-to-one name="Productos" class="Productos" update="false" insert="false">
      <column name="idproducto" default="N''" not-null="true" length="3" sql-type="nvarchar" />
    </many-to-one>
    <many-to-one name="Proveedores" class="Proveedores" update="false" insert="false">
      <column name="FKIdProveedor" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </many-to-one>
  </class>
</hibernate-mapping>