<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="CalcAbEifPreparacion" table="calc_ab_eif_preparacion">
    <id name="Id" type="Int32">
      <column name="id" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Text" type="String">
      <column name="Text" default="N''" not-null="true" length="50" sql-type="nvarchar" />
    </property>
    <property name="Value" type="Single">
      <column name="Value" default="0" not-null="true" precision="24" sql-type="real" />
    </property>
    <set name="CalcCorrespondencias" inverse="true" generic="true">
      <key>
        <column name="idTiempoPreparacionAbEif" />
      </key>
      <one-to-many class="CalcCorrespondencias" />
    </set>
  </class>
</hibernate-mapping>