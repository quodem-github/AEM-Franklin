    <property name="Idservicesuscriptor" type="Int32">
      <column name="IdServiceSuscriptor" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Hashedkey" type="String">
      <column name="HashedKey" default="NULL" not-null="false" length="100" sql-type="nvarchar" />
    </property>
    <property name="Createdate" type="DateTime">
      <column name="CreateDate" default="NULL" not-null="false" sql-type="datetime2" />
    </property>
    <property name="Updatedate" type="DateTime">
      <column name="UpdateDate" default="NULL" not-null="false" sql-type="datetime2" />
    </property>
    <property name="Randonguid" type="String">
      <column name="RandonGuid" default="NULL" not-null="false" length="50" sql-type="nvarchar" />
