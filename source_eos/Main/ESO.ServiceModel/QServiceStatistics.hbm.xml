<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="QServiceStatistics" table="q_service_statistics">
    <id name="Iservicestatistic" type="Int32">
      <column name="IServiceStatistic" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Idsuscriptor" type="Int32">
      <column name="IdSuscriptor" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Idservice" type="Int32">
      <column name="IdService" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Method" type="String">
      <column name="Method" default="NULL" not-null="false" length="50" sql-type="nvarchar" />
    </property>
    <property name="Params" type="String">
      <column name="Params" not-null="false" sql-type="varchar" />
    </property>
    <property name="Createddate" type="DateTime">
      <column name="CreatedDate" not-null="true" sql-type="datetime2" />
    </property>
    <property name="Resultstatus" type="Int32">
      <column name="ResultStatus" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <many-to-one name="QService" class="QService" update="false" insert="false">
      <column name="IdService" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </many-to-one>
    <many-to-one name="QSuscriptor" class="QSuscriptor" update="false" insert="false">
      <column name="IdSuscriptor" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </many-to-one>
  </class>
</hibernate-mapping>