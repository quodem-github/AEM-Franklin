<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="Reservasviajes" table="reservasviajes">
    <id name="Idreserva" type="Int32">
      <column name="idreserva" default="0" not-null="true" precision="10" scale="0" sql-type="int" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Reserva" type="String">
      <column name="reserva" not-null="true" sql-type="nvarchar" />
    </property>
    <property name="Fechapeticion" type="DateTime">
      <column name="fechapeticion" not-null="true" sql-type="datetime2" />
    </property>
    <property name="Idestado" type="String">
      <column name="idestado" default="N''" not-null="true" length="5" sql-type="nvarchar" />
    </property>
    <property name="Lastupd" type="DateTime">
      <column name="LastUpd" default="NULL" not-null="false" sql-type="datetime2" />
    </property>
    <property name="Lastlog" type="String">
      <column name="LastLog" default="N''" not-null="false" length="35" sql-type="nvarchar" />
    </property>
    <property name="Idpeticionario" type="Int32">
      <column name="IdPeticionario" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Observaciones" type="String">
      <column name="Observaciones" not-null="false" sql-type="nvarchar" />
    </property>
    <property name="ObservAgencia" type="String">
      <column name="observ_agencia" not-null="false" sql-type="nvarchar" />
    </property>
    <property name="Mainreserva" type="String">
      <column name="mainreserva" default="N''" not-null="false" length="20" sql-type="nvarchar" />
    </property>
    <property name="Fkidexpediente" type="Int32">
      <column name="fkidexpediente" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <many-to-one name="Expediente" class="Expediente" update="false" insert="false">
      <column name="fkidexpediente" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </many-to-one>
    <many-to-one name="Peticionarios" class="Peticionarios" update="false" insert="false">
      <column name="IdPeticionario" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </many-to-one>
    <many-to-one name="Estadosreservas" class="Estadosreservas" update="false" insert="false">
      <column name="idestado" default="N''" not-null="true" length="5" sql-type="nvarchar" />
    </many-to-one>
    <set name="Serviciosreservasviajes" inverse="true" generic="true">
      <key>
        <column name="idreserva" />
      </key>
      <one-to-many class="Serviciosreservasviajes" />
    </set>
    <set name="EstadosReservas" inverse="true" generic="true">
      <key>
        <column name="idreserva" />
      </key>
      <one-to-many class="EstadosReservas" />
    </set>
  </class>
</hibernate-mapping>