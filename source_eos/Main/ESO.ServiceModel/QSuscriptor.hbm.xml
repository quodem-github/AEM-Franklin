<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="QSuscriptor" table="q_suscriptor">
    <id name="Idsuscriptor" type="Int32">
      <column name="IdSuscriptor" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Publickey" type="String">
      <column name="PublicKey" default="NULL" not-null="false" length="255" sql-type="nvarchar" />
    </property>
    <property name="Privatekey" type="String">
      <column name="PrivateKey" default="NULL" not-null="false" length="255" sql-type="nvarchar" />
    </property>
    <property name="Title" type="String">
      <column name="Title" default="NULL" not-null="false" length="255" sql-type="nvarchar" />
    </property>
    <property name="Status" type="Int32">
      <column name="Status" default="NULL" not-null="false" length="1" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Creationdate" type="DateTime">
      <column name="CreationDate" default="NULL" not-null="false" sql-type="datetime2" />
    </property>
    <set name="QServiceStatistics" inverse="true" generic="true">
      <key>
        <column name="IdSuscriptor" />
      </key>
      <one-to-many class="QServiceStatistics" />
    </set>
    <set name="QServiceSuscriptors" inverse="true" generic="true">
      <key>
        <column name="IdSuscriptor" />
      </key>
      <one-to-many class="QServiceSuscriptor" />
    </set>
  </class>
</hibernate-mapping>