<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="Productos" table="productos">
    <id name="Idproducto" type="String">
      <column name="idproducto" default="N''" not-null="true" length="3" sql-type="nvarchar" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Producto" type="String">
      <column name="producto" default="N''" not-null="true" length="30" sql-type="nvarchar" />
    </property>
    <property name="Inactivo" type="Int16">
      <column name="inactivo" default="0" not-null="false" precision="5" scale="0" sql-type="smallint" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <set name="Tarifasactividads" inverse="true" generic="true">
      <key>
        <column name="idproducto" />
      </key>
      <one-to-many class="Tarifasactividad" />
    </set>
    <set name="Tarifasalojs" inverse="true" generic="true">
      <key>
        <column name="idproducto" />
      </key>
      <one-to-many class="Tarifasaloj" />
    </set>
    <set name="Tarifasinscripcions" inverse="true" generic="true">
      <key>
        <column name="idproducto" />
      </key>
      <one-to-many class="Tarifasinscripcion" />
    </set>
    <set name="ProductosPrvs" inverse="true" generic="true">
      <key>
        <column name="idproducto" />
      </key>
      <one-to-many class="ProductosPrv" />
    </set>
  </class>
</hibernate-mapping>