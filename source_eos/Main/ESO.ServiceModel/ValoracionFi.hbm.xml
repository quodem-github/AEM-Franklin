<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="ValoracionFi" table="valoracion_fi">
    <id name="Idvaloracionfi" type="Int32">
      <column name="idvaloracionfi" default="0" not-null="true" precision="10" scale="0" sql-type="int" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Descripcion" type="String">
      <column name="descripcion" default="N''" not-null="true" length="35" sql-type="nvarchar" />
    </property>
    <property name="Color" type="Int32">
      <column name="color" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="NULL" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <set name="Congresos" inverse="true" generic="true">
      <key>
        <column name="idvaloracionfi" />
      </key>
      <one-to-many class="Congresos" />
    </set>
  </class>
</hibernate-mapping>