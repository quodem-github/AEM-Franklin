<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="TiposPrv" table="tipos_prv">
    <id name="Idtipoprv" type="String">
      <column name="IdTipoPrv" default="N''" not-null="true" length="3" sql-type="nvarchar" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Tipoproveedor" type="String">
      <column name="TipoProveedor" default="N''" not-null="true" length="30" sql-type="nvarchar" />
    </property>
    <property name="Idtipobono" type="String">
      <column name="IdTipoBono" default="N''" not-null="true" length="3" sql-type="nvarchar" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <set name="Proveedores" inverse="true" generic="true">
      <key>
        <column name="IdTipoPrv" />
      </key>
      <one-to-many class="Proveedores" />
    </set>
  </class>
</hibernate-mapping>