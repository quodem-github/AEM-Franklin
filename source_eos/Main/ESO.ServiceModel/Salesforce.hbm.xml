<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="Salesforce" table="salesforce">
    <id name="Idsaleforce" type="Int32">
      <column name="idsaleforce" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Iddepartament" type="Int32">
      <column name="iddepartament" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Idempresa" type="Int32">
      <column name="IdEmpresa" default="0" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Saleforce" type="String">
      <column name="saleforce" default="N''" not-null="true" length="80" sql-type="nvarchar" />
    </property>
    <property name="Inactivo" type="Int32">
      <column name="inactivo" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <many-to-one name="Departaments" class="Departaments" update="false" insert="false">
      <column name="iddepartament" not-null="false" precision="10" scale="0" sql-type="int" />
    </many-to-one>
    <set name="Expedientes" inverse="true" generic="true">
      <key>
        <column name="idsaleforce" />
      </key>
      <one-to-many class="Expediente" />
    </set>
    <set name="Peticionarios" inverse="true" generic="true">
      <key>
        <column name="idsaleforce" />
      </key>
      <one-to-many class="Peticionarios" />
    </set>
    <set name="PeticionGrupos" inverse="true" generic="true">
      <key>
        <column name="idsaleforce" />
      </key>
      <one-to-many class="PeticionGrupos" />
    </set>
    <set name="Districts" inverse="true" generic="true">
      <key>
        <column name="idsaleforce" />
      </key>
      <one-to-many class="Districts" />
    </set>
  </class>
</hibernate-mapping>