<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="EOS.ServiceModel" namespace="EOS.ServiceModel" xmlns="urn:nhibernate-mapping-2.2">
  <class name="TiposreservasWeb" table="tiposreservas_web">
    <id name="Idtiporeserva" type="Int32">
      <column name="IdTipoReserva" default="0" not-null="true" precision="10" scale="0" sql-type="int" unique="true" />
      <generator class="assigned" />
    </id>
    <property name="Descripcion" type="String">
      <column name="Descripcion" default="N''" not-null="true" length="80" sql-type="nvarchar" />
    </property>
    <property name="Locked" type="Int32">
      <column name="locked" default="0" not-null="false" precision="10" scale="0" sql-type="int" />
    </property>
    <set name="Expedientes" inverse="true" generic="true">
      <key>
        <column name="IdTipoReserva" />
      </key>
      <one-to-many class="Expediente" />
    </set>
  </class>
</hibernate-mapping>