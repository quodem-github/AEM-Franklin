<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Process.Msd.Spotfire.CsvGenerator.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="Process.Msd.Spotfire.CsvGenerator.Properties.Settings.SqlConnectionString"
      connectionString="Server=PRE-DBServer01.quodem.net;Database=WINTOUR_ROBOT_EOS-STAGING;User Id=quodem_web;Password=Quowppo10;"
      providerName="Sql.Data.SqlClient" />
    
    
  </connectionStrings>
  <userSettings>
    <Process.Msd.Spotfire.CsvGenerator.Properties.Settings>
      <setting name="FileLogDirectory" serializeAs="String">
        <value>C:\Temp\EOSProcess\</value>
      </setting>
      <setting name="StoreProcedurePrepare" serializeAs="String">
        <value>sp_hcp_report_prepare</value>
      </setting>
      <setting name="StoreProcedureDataName" serializeAs="String">
        <value>sp_hcp_report</value>
      </setting>
      <setting name="FileExportDirectory" serializeAs="String">
        <value>C:\Temp\EOSProcess\</value>
      </setting>
      <setting name="EmailFrom" serializeAs="String">
        <value>noreply@quodem.com</value>
      </setting>
      <setting name="EmailList" serializeAs="String">
        <value>jmartin@quodem.com</value>
      </setting>
    </Process.Msd.Spotfire.CsvGenerator.Properties.Settings>
  </userSettings>
  <appSettings>
    <!-- Configuracion del proceso -->
    <add key="Monitor.LogName" value="MSD-SpotfireCsvGenerator" />
    <add key="Quodem.Monitor.Procesos.Nombre" value="msd.SpotfireCsvGenerator" />
    <add key="Quodem.Monitor.Procesos.Para" value="jmartin@quodem.com" />
    <add key="Quodem.Monitor.Procesos.TipoLog" value="Ejecucion" />
    <add key="Quodem.Monitor.Procesos.EnvioLog" value="Error" />
    <add key="Quodem.Monitor.Procesos.EnvioMail" value="Siempre" />
    <add key="Quodem.Monitor.Procesos.NivelMensajes" value="5" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
</configuration>