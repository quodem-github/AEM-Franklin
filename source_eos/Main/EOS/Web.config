    <add key="Data.Interoperability.MaxSessionTime" value="3600" />
    <!-- Configuraciones para servicios API -->
    <add key="API.PeticionariosList.PageSize" value="100" />
    <add key="API.PassengersList.PageSize" value="1000" />
    <add key="API.Service.PageSize" value="1000" />
    <!--Ip Quodem para login falso-->
    <add key="QuodemIp" value="77.225.97.180" />
