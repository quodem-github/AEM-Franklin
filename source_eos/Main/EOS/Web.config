<configuration>
  <configSections>
    <!-- Configure Multiple Factories-->
    <section name="hibernate-configuration-x-factories" type="NHibernate.Cfg.ConfigurationSectionHandler, NHibernate" />
    <!-- Configure NHibernate Validator-->
    <section name="nhv-configuration" type="NHibernate.Validator.Cfg.ConfigurationSectionHandler, NHibernate.Validator" />
    <!-- Log Nhibernate -->
    <!--<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />-->
    <section name="hibernate-configuration" type="NHibernate.Cfg.ConfigurationSectionHandler, NHibernate" />
    <section name="nhibernate" type="System.Configuration.NameValueSectionHandler, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
  </configSections>
  <connectionStrings>
    <clear />
    <add name="EOS.CadenaConexionSql" connectionString="Server=PRE-DBServer01.quodem.net;Database=WINTOUR_ROBOT_EOS-STAGING;Uid=quodem_web;Pwd=Quowppo10" providerName="Sql.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <!--Cadena de conexion-->
    <add key="Sql.Custom.CadenaConexionSql" value="EOS.CadenaConexionSql" />
    <add key="EOS.CadenaConexionSql" value="Data Source=PRE-DBServer01.quodem.net;Initial Catalog=WINTOUR_ROBOT_EOS-STAGING;user id=quodem_web;Password=Quowppo10"/>
    <!--EOS-Veeva.CadenaConexionSql-->
    <!--Load file NHibernate Configuration-->
    <add key="Quodem.ORM.NHibernate.FileHibernate" value="hibernate.cfg.xml" />
    <!--Load File for MultiConnection-->
    <add key="Quodem.ORM.NHibernate.FileHibernateMultiConnection" value="hibernatemulticonnection.cfg.xml" />
    <!-- Quodem.Monitor -->
    <add key="Monitor.Type" value="LOG" />
    <add key="Monitor.Description" value="eosmsd.com" />
    <add key="Monitor.LogName" value="eosmsd.com.log" />
    <add key="Monitor.CC_Recipients" value="jmartin@quodem.com" />
    <!-- MySQL -->
    <add key="SQL.CommandTimeout" value="180" />
    <!-- Claves Originales -->
    <add key="FiltroInforme" value="Informes/FiltroInforme.aspx" />
    <add key="CarpetaTemp" value="W:\Inetpub\vhosts\eosmsd.com\httpdocs\Informes\src\Temp\" />
    <add key="CarpetaInforme" value="W:\Inetpub\vhosts\eosmsd.com\httpdocs\Informes\src\" />
    <add key="PathDocuments" value="W:\Inetpub\vhosts\eosmsd.com\httpdocs\App_Data\Documentacion\" />
    <add key="PathFicherosExcel" value="W:\Inetpub\vhosts\eosmsd.com\httpdocs\Informes\src\" />
    <!--Logs-->
    <add key="ActivarLog" value="0" />
    <add key="LogPath" value="C:\LOG\Eos\" />
    <add key="LOG_FILE" value="log.txt" />
    <!--EMAILS-->
    <add key="ContactoMail" value="jmartin@quodem.com" />
    <add key="ContactoError" value="jmartin@quodem.com" />
    <add key="CopiaContacto" value="jmartin@quodem.com" />
    <add key="IdEmpresa" value="1257" />
    <!--<add key="AMECUpload" value ="C:\WEB-SERVER\EOS-DOCUMENTACION\AMECS\"/>-->
    <add key="AMECUpload" value="G:\EOS\AMECS\" />
    <!-- Para todo el sistema de gestion de archivos en los expedientes -->
    <!--<add key="AmecDocumentation" value="~/App_Data/Documentacion/AMECS/" />-->
    <add key="AmecDocumentation" value="C:\EOS\AMECS\" />
    <add key="AmecDocumentationTemp" value="~/App_Data/Documentacion/AMECS/Temp/" />
    <!-- Para todo el sistema de gestion de archivos en los expedientes -->
    <add key="MailCopia" value="jmartin@quodem.com" />
    <add key="MailCasosClinicos" value="jmartin@quodem.com" />
    <add key="MailGestorArchivos" value="jmartin@quodem.com" />
    <!--<add key="MailDeptMedico" value="PRCProgramasMe@merck.com"/>
    <add key="MailDeptLegal" value="AMEC_legal@merck.com"/>-->
    <add key="MailDeptMedico" value="jmartin@quodem.com" />
    <add key="MailDeptLegal" value="jmartin@quodem.com" />
    <add key="AmecReunionesInternas" value="999999999" />
    <add key="RutaLinkMailAmec" value="http://eosmsd.com.quodem.net/" />
    <add key="MailCopiaProgramador" value="" />
    <add key="MailCCHCP" value="" />
    <add key="RutaDescargaDocumentacion" value="http://eosmsd.com.quodem.net/DownloadProgramDoc.aspx?Tipodoc=Documentacion" />
    <add key="RutaLogs" value="C:\QUODEM\Temporal\LogFiles\quodem.apps\grupo-pacifico.eosmsd.com\" />
    <!-- Configuración MAIL Alternativa (Se utiliza cuando la otra configuración está fallando, en el cacth del proyecto se envia por esta configuración) -->
    <add key="HostMail" value="smtp-apps.quodem.com" />
    <add key="UserNameMail" value="quodem_smtp" />
    <add key="PortMail" value="25" />
    <add key="PasswordMail" value="Planner12" />
