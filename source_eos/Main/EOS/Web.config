    <!-- Tiempo límite de conexión -->
    <add key="LimiteComandoConexion" value="50000" />
    <!-- FIN Tiempo límite de conexión -->
    <!-- JLG:son las variables de etiquetas y control de AMECS para que la herramienta se pueda utilizar con otros clientes y desactivar el modulo de amecs -->
    <add key="codigoPresupuesto" value="AMEC" />
    <add key="codigoInvitado" value="MSDID" />
    <add key="controlPresupuesto" value="1" />
    <add key="informesGrupos" value="1" />
    <add key="runType" value="DEVELOPMENT" />
    <!-- FIN de variables de etiquetas y control de AMECS. -->
