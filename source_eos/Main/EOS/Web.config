    <add key="Quodem.SamlIV" value="NDNhMTQwMzYtNjg3NC00N2E0LTkyN2YtYjVkNjZjMTJjNmM5" />
    <add key="Quodem.SamlKey" value="YmE4MjZmMTctOWE0NC00ZGFhLWE4MjUtNzFkOGIzM2JhNGQ0" />
    <add key="Quodem.AppName" value="EOSWEB" />
    <add key="Quodem.MobileAppName" value="" />
